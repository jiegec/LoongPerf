{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LoongArch instruction measurements",
  "description": "Measurements for one instruction on one microarchitecture. The latency part follows the structure of a uops.info html-lat measurement page. The microarchitecture and instruction are encoded in the file path, e.g. docs/data/la664/adc.b.json.",
  "type": "object",
  "required": [
    "instruction",
    "operands",
    "measurement",
    "latencies"
  ],
  "properties": {
    "instruction": {
      "$ref": "#/$defs/instruction"
    },
    "operands": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/operand"
      }
    },
    "measurement": {
      "$ref": "#/$defs/measurement"
    },
    "latencies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/latency"
      }
    },
    "throughput": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/experiment"
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "instruction": {
      "type": "object",
      "required": [
        "name",
        "extension",
        "form",
        "description"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9_.]+$"
        },
        "form": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "extension": {
          "enum": [
            "Base",
            "LBT",
            "LSX",
            "LASX"
          ]
        }
      },
      "additionalProperties": false
    },
    "operand": {
      "type": "object",
      "required": [
        "index",
        "name",
        "kind",
        "access"
      ],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "gpr",
            "fpr",
            "vector",
            "immediate",
            "memory",
            "flags",
            "other"
          ]
        },
        "access": {
          "enum": [
            "read",
            "write",
            "read-write",
            "none"
          ]
        },
        "implicit": {
          "type": "boolean",
          "default": false
        },
        "suppressed": {
          "type": "boolean",
          "default": false
        },
        "bits": {
          "type": "integer",
          "minimum": 1
        },
        "description": {
          "type": "string"
        },
        "flags": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/flag_access"
          }
        }
      },
      "additionalProperties": false
    },
    "flag_access": {
      "enum": [
        "read",
        "write",
        "read-write"
      ]
    },
    "measurement": {
      "type": "object",
      "required": [
        "tool",
        "unroll",
        "iters",
        "warmup",
        "reps",
        "core"
      ],
      "properties": {
        "tool": {
          "type": "string",
          "minLength": 1
        },
        "unroll": {
          "type": "integer",
          "minimum": 1
        },
        "iters": {
          "type": "integer",
          "minimum": 1
        },
        "warmup": {
          "type": "integer",
          "minimum": 0
        },
        "reps": {
          "type": "integer",
          "minimum": 1
        },
        "core": {
          "type": "integer"
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "latency": {
      "type": "object",
      "required": [
        "from_operands",
        "to_operand",
        "cycles",
        "experiments"
      ],
      "properties": {
        "from_operands": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "to_operand": {
          "type": "integer",
          "minimum": 1
        },
        "cycles": {
          "type": "number",
          "minimum": 0
        },
        "experiments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/experiment"
          }
        },
        "notes": {
          "type": "string"
        },
        "cycles_min": {
          "type": "number",
          "minimum": 0
        },
        "cycles_max": {
          "type": "number",
          "minimum": 0
        },
        "cycles_divisor": {
          "type": "integer",
          "minimum": 1
        },
        "cases": {
          "type": "array",
          "minItems": 2,
          "description": "Special cases of a data-dependent latency, each with a name and its measured cycles. If the listed cases cover every possible operand (floating-point divide, square root, reciprocal) they are exhaustive and the notes need no formula; if they do not (integer divide, whose latency is a continuous ladder) the notes must also state the formula that covers the rest, and cycles_min/cycles_max remain the authoritative range.",
          "items": {
            "type": "object",
            "required": [
              "name",
              "cycles"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "cycles": {
                "type": "number",
                "minimum": 0
              },
              "notes": {
                "type": "string"
              },
              "experiment": {
                "$ref": "#/$defs/experiment"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "experiment": {
      "type": "object",
      "required": [
        "asm",
        "command",
        "result"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "role": {
          "enum": [
            "measurement",
            "calibration",
            "baseline",
            "dependency-breaking"
          ]
        },
        "asm": {
          "type": "string",
          "minLength": 1
        },
        "init": {
          "type": "string"
        },
        "chain_instructions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "chain_latency": {
          "type": "number",
          "minimum": 0
        },
        "dependency_breaking": {
          "type": "boolean"
        },
        "machine_code": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "command": {
          "type": "string",
          "minLength": 1
        },
        "result": {
          "$ref": "#/$defs/result"
        },
        "throughput": {
          "$ref": "#/$defs/throughput"
        },
        "notes": {
          "type": "string"
        },
        "measurement": {
          "$ref": "#/$defs/measurement_override"
        },
        "baseline_cycles": {
          "type": "number",
          "minimum": 0
        },
        "loops": {
          "type": "integer",
          "minimum": 1,
          "description": "Number of times the loop body in the asm is executed."
        },
        "loop_instructions": {
          "type": "integer",
          "minimum": 1,
          "description": "Number of static asm instructions in the loop body, counting backward from the end of the asm."
        }
      },
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "required": [
        "instructions_retired",
        "core_cycles"
      ],
      "properties": {
        "instructions_retired": {
          "type": "number",
          "minimum": 0
        },
        "core_cycles": {
          "type": "number",
          "minimum": 0
        },
        "reference_cycles": {
          "type": "number",
          "minimum": 0
        },
        "counters": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        }
      },
      "additionalProperties": false
    },
    "throughput": {
      "type": "object",
      "required": [
        "lanes",
        "cpi",
        "ipc"
      ],
      "properties": {
        "lanes": {
          "type": "integer",
          "minimum": 1
        },
        "cpi": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "ipc": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "cpi_min": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "cpi_max": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "ipc_min": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "ipc_max": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "additionalProperties": false
    },
    "measurement_override": {
      "type": "object",
      "properties": {
        "unroll": {
          "type": "integer",
          "minimum": 1
        },
        "iters": {
          "type": "integer",
          "minimum": 1
        },
        "warmup": {
          "type": "integer",
          "minimum": 0
        },
        "reps": {
          "type": "integer",
          "minimum": 1
        },
        "core": {
          "type": "integer"
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}
